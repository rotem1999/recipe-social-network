# Copy to .env.local and fill in. .env.local is gitignored and must never be committed.

# --- API ---
NODE_ENV=development
API_PORT=3000
API_GLOBAL_PREFIX=api/v1

# --- Database (PostgreSQL 18) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=recipe_app
DB_PASSWORD=
DB_NAME=recipe_social_network
# TypeORM synchronize is always false — schema changes go through migrations only.

# --- Auth ---
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=30d

# --- Object storage (recipe photos) — S3-compatible ---
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Web renderer (build-time, PUBLIC — never put a secret here) ---
VITE_API_BASE_URL=http://localhost:3000/api/v1
