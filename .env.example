# Copy to .env.local and fill in. .env.local is gitignored and must never be committed.

# --- API ---
NODE_ENV=development
API_PORT=3000
API_GLOBAL_PREFIX=api/v1

# --- Database (PostgreSQL 18) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=recipe_app
DB_PASSWORD=
DB_NAME=recipe_social_network
# TypeORM synchronize is always false — schema changes go through migrations only.

# --- Auth ---
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=30d

# --- Encryption for user-supplied model keys (see ARCHITECTURE.md §6.9) ---
# 32-byte key, base64. Rotating this invalidates every stored user key.
MODEL_KEY_ENCRYPTION_KEY=

# --- TheMealDB (recipe catalogue) ---
# '1' is the public development key. Buy the £10 lifetime premium key before any
# public release: the free tier forbids app-store distribution. See §5.1.
THEMEALDB_KEY=1
THEMEALDB_BASE_URL=https://www.themealdb.com/api/json/v1

# --- USDA FoodData Central (nutrition) — free key from https://fdc.nal.usda.gov/api-key-signup
# Data is CC0 public domain: cacheable indefinitely. ~1000 req/hour. See §5.2.
USDA_FDC_KEY=
USDA_FDC_BASE_URL=https://api.nal.usda.gov/fdc/v1

# --- OpenRouter (recipe import fallback + cooking assistant) ---
# Shared server key. Free models are capped at 20 req/min and 50 req/DAY per ACCOUNT
# (1000/day once $10 of credits has been purchased). See §5.3.
OPENROUTER_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Ordered fallback list — NEVER hardcode a single model, the free roster churns.
OPENROUTER_MODEL_PREFERENCE=
# Per-user daily budget when using the shared key.
OPENROUTER_SHARED_DAILY_QUOTA_PER_USER=20

# --- Object storage (recipe photos) — S3-compatible. Still open, see §13. ---
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Web renderer (build-time, PUBLIC — never put a secret here) ---
VITE_API_BASE_URL=http://localhost:3000/api/v1
