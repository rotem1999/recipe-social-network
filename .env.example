# CookBook environment (SPEC.md §14, regenerated 2026-09-28).
# Copy this file to .env.local and fill every empty value. .env.local is gitignored
# and is never read, written or staged by Claude. The API loads .env.local, then .env.

# --- API (SPEC §11.6) ---
NODE_ENV=development
API_PORT=3000
API_GLOBAL_PREFIX=api/v1
# Comma-separated renderer origins allowed by CORS (dev server and Electron).
CORS_ORIGINS=http://localhost:4200,http://localhost:4300

# --- Database (SPEC §12, PostgreSQL 18 on this machine, port 5432) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=recipe_app
DB_PASSWORD=
DB_NAME=recipe_social_network
# TypeORM synchronize is always false; schema changes go through migrations only (DB-3).

# --- Auth (SPEC §2 AUTH-7): two different long random strings, e.g. `openssl rand -base64 48` ---
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=30d

# --- TheMealDB v2, paid key (SPEC §3.3 CAT-1) ---
THEMEALDB_KEY=
THEMEALDB_BASE_URL=https://www.themealdb.com/api/json/v2

# --- USDA FoodData Central (SPEC §9), free key from https://fdc.nal.usda.gov/api-key-signup ---
USDA_FDC_KEY=
USDA_FDC_BASE_URL=https://api.nal.usda.gov/fdc/v1

# --- OpenRouter (SPEC §7), one shared server key ---
OPENROUTER_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=minimax/minimax-m3
# AI requests per user per day, cook mode and recommendations combined (COOK-8).
OPENROUTER_SHARED_DAILY_QUOTA_PER_USER=100
# Optional: folder for the AI prompt log (SPEC §10). Leave empty for <repo root>/log.
PROMPT_LOG_DIR=

# --- Open-Meteo (SPEC §8), no key ---
OPENMETEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPENMETEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search

# --- Recipe images: Cloud Storage for Firebase through the Admin SDK (SPEC §3.4) ---
# Leave the three FIREBASE_* values empty to run without image uploads (IMG-6).
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
# Absolute path to the service-account JSON, outside the repository.
FIREBASE_SERVICE_ACCOUNT_PATH=
# Signed URL lifetime in seconds, at most 604800 (7 days).
IMAGE_SIGNED_URL_TTL_SECONDS=21600

# --- Web renderer (build-time, PUBLIC; never put a secret here) ---
VITE_API_BASE_URL=http://localhost:3000/api/v1
